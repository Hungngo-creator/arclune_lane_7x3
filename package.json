{
  "name": "arclune_lane_7x3",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "npm run build:prod",
    "build:dev": "node tools/generate-loithienanh-svg.mjs && node build.mjs --mode=development",
    "build:prod": "node tools/generate-loithienanh-svg.mjs && node build.mjs --mode=production",
    "dev": "APP_ENTRY=${APP_ENTRY:-src/main.ts} node tools/tsx-stub/bin.js watch $APP_ENTRY",
    "start": "NODE_ENV=${NODE_ENV:-production} APP_ENTRY=${APP_ENTRY:-src/main.ts} node tools/tsx-stub/bin.js $APP_ENTRY",
    "test": "jest --runInBand --passWithNoTests",
    "ci": "npm run check:duplicate-declarations && npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "postinstall": "node tools/install-stubs.mjs",
    "typecheck:all": "tsc --noEmit -p tsconfig.all.json",
    "verify:aether-bundle": "node tools/verify-aether-bundle.mjs",
    "smoke:long-battle": "node simulations/long-battle-smoke.mjs",
    "release:gate": "npm test && npm run smoke:long-battle",
    "check:duplicate-declarations": "node tools/check-duplicate-declarations.mjs",
    "verify:tag-runtime": "jest --runInBand test/combat-tag-dispatch.test.ts test/tag-effect-e2e.test.ts",
    "build:dev:chess-strategy-rpg": "node tools/generate-loithienanh-svg.mjs && node build.mjs --mode=development --prune-unreachable --skip-bundle-verify"
  },
